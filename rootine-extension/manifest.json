{
  "manifest_version": 3,
  "name": "Rootine Focus Plant",
  "version": "0.2.0",
  "description": "Tracks focused and distracted time to protect your Rootine plant.",
  "permissions": ["storage", "tabs", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Rootine Focus Plant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*.html"
      ],
      "js": ["dashboard-bridge.js"]
    }
  ]
}
